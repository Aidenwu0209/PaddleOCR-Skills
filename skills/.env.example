# ============================================
# PaddleOCR Skills Configuration
# ============================================
# Copy this file to .env and fill in your credentials.
# Get your API credentials at: https://paddleocr.com

# ============================================
# Text Recognition
# ============================================
# Full OCR endpoint (the script will normalize to end with /ocr)
# Example: PADDLEOCR_OCR_API_URL=https://xxx.aistudio-app.com/ocr
PADDLEOCR_OCR_API_URL=

# Access Token (shared between skills)
# Example: PADDLEOCR_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLEOCR_ACCESS_TOKEN=

# Optional timeout in seconds (default: 120)
# PADDLEOCR_TIMEOUT=120

# ============================================
# Document Parsing
# ============================================
# Full document parsing endpoint
# Example: PADDLEOCR_DOC_PARSING_API_URL=https://xxx.aistudio-app.com/layout-parsing
PADDLEOCR_DOC_PARSING_API_URL=

# Optional timeout in seconds (default: 600)
# PADDLEOCR_DOC_PARSING_TIMEOUT=600

# ============================================
# Legacy fallback keys (Text Recognition only)
# ============================================
# The text-recognition library still supports these legacy names:
# - PADDLEOCR_API_URL  -> PADDLEOCR_OCR_API_URL
# - API_URL            -> PADDLEOCR_OCR_API_URL
# - PADDLEOCR_TOKEN    -> PADDLEOCR_ACCESS_TOKEN
# - PADDLE_OCR_TOKEN   -> PADDLEOCR_ACCESS_TOKEN
